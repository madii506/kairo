{
  "cleanUrls": true,
  "functions": {
    "api/kairo.js": {
      "maxDuration": 60
    },
    "api/launch.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/launch",
      "destination": "/api/launch"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/kairo?__p=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' wss://pumpportal.fun; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(fonts|vendor|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}